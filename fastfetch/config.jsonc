{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "display": {
    "separator": " : ",
    "color": {
      "keys": "#7aa2f7",
      "title": "#7dcfff",
      "output": "#c0caf5",
      "separator": "#414868"
    },
    "key": {
      "width": 12
    },
    "percent": {
      "type": 9
    }
  },

  // Gif
  // "logo": {
  //   "type": "kitty",
  //   "source": "/home/rj/Pictures/Pin/chisa.gif",
  //   "width": 30,
  //   "animationFrame": 0,
  //   "padding": {
  //     "right": 2
  //   }
  // },

  "logo": {
    "type": "kitty",
    "source": "/home/rj/Pictures/Pin/cat1.jpeg",
    "width": 30,
    "padding": {
      "right": 2
    }
  },

  "modules": [
    "title",
    {
      "type": "custom",
      "key": " ",
      "format": "{##7DCFFF}┌─ HARDWARE ─────────────────────────────────────────────────────┐{#}"
    },
    {
      "type": "cpu",
      "format": "{name} ({cores-physical}C/{cores-logical}T)"
    },
    "gpu",
    "memory",
    "disk",
    {
      "type": "battery",
      "key":  "Battery"
    },
    "break",
    {
      "type": "custom",
      "key": " ",
      "format": "{##BB9AF7}├─ SOFTWARE ─────────────────────────────────────────────────────┤{#}"
    },
    {
      "type": "os",
      "key": "OS"
    },
    "kernel",
    "de",
    {
      "type": "wm",
      "key": "WM"
    },
    "shell",
    "terminal",

    "break",
    {
      "type": "custom",
      "key": " ",
      "format": "{##9ECE6A}└─ UPTIME ───────────────────────────────────────────────────────┘{#}"
    },
    "uptime"
  ]
}


